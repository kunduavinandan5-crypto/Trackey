# Supabase Configuration
# Get these from your Supabase Project Settings -> API: https://supabase.com/dashboard
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Public site origin (no trailing slash). Enables canonical URL, og:url/og:image and sitemap.xml.
VITE_SITE_URL=https://your-domain.example

# ── Spendly AI assistant (SERVER-SIDE ONLY — never prefix these with VITE_) ──
# Set at least one key. In production add them in Vercel -> Project Settings -> Environment Variables.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Which provider answers by default when both keys are set: gemini | claude
AI_PROVIDER=gemini
# Optional model overrides
# GEMINI_MODEL=gemini-3.8-flash
# ANTHROPIC_MODEL=claude-haiku-5-5
