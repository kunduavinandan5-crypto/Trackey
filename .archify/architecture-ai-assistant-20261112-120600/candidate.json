  "cards": [
    {
      "dot": "rose",
      "title": "Zero-Trust Data Isolation",
      "items": [
        "The browser client never sends raw financial records; only the question and user JWT are transmitted.",
        "The serverless function queries Supabase REST v1 with the caller's JWT, enforcing PostgreSQL Row Level Security (RLS).",
        "Cross-user data leakage is cryptographically impossible because queries execute under the caller's database role."
      ]
    },
    {
      "dot": "emerald",
      "title": "Semantic In-Memory Cache",
      "items": [
        "Fingerprints user context + today's date via SHA-256; any new transaction or day rolls the cache automatically.",
        "Jaccard word similarity (80% threshold) detects rephrased queries ('what did I spend' vs 'how much did I spend').",
        "Zero latency and zero token cost on cache hits; ephemeral memory resets on cold starts."
      ]
    },
    {
      "dot": "cyan",
      "title": "Serverless Model Orchestration",
      "items": [
        "API keys (GEMINI_API_KEY, ANTHROPIC_API_KEY) live strictly in server environment secrets, never exposed to clients.",
        "Rate limiter restricts traffic to 20 requests per 5-minute rolling window per authenticated user.",
        "Supports Google Gemini 1.5 Flash as primary, with seamless fallback to Anthropic Claude 3.5 Sonnet."
      ]
    }
  ]
